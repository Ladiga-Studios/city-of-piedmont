# Supabase — copy to .env.local and fill in from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only key for admin actions (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Anthropic API key — used server-side to summarize minutes (NEVER expose to client)
ANTHROPIC_API_KEY=sk-ant-your-key
# Google Maps key — used SERVER-SIDE to turn business addresses into map coordinates.
# Enable the "Geocoding API" on this key and turn on billing. NEVER expose to client.
GOOGLE_MAPS_API_KEY=your-google-maps-key

# ---- Permanent Record (Fangorn) — OPTIONAL ----
# Leave these unset and the site behaves exactly as before; records
# simply stay 'pending' until anchoring is configured.
# See README-FANGORN.md for full setup (wallet, testnet ETH, Pinata,
# one-time publisher registration).
#
# Private key of the CITY'S dedicated publishing wallet (0x-prefixed).
# Treat like a password. Use a wallet created for this purpose only —
# never a personal wallet. NEVER expose to client.
FANGORN_PRIVATE_KEY=0x-your-city-publisher-key
# Pinata credentials (free tier is fine for hash-only anchoring)
FANGORN_PINATA_JWT=your-pinata-jwt
FANGORN_PINATA_GATEWAY=https://your-gw.mypinata.cloud
# App id scoping the city's namespaces (default: piedmont-al)
FANGORN_APP_ID=piedmont-al
